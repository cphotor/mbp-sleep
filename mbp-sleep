#!/usr/bin/env python3
"""mbp-sleep -- the only program this machine uses to manage suspend and resume.

It is installed to /usr/local/sbin/mbp-sleep and has two entry points:

  * the daemon, started by mbp-sleep.service at boot.  It re-arms the ACPI wake
    sources, takes over the lid switch, and holds a logind block lock while a
    backup is running so a suspend request cannot interrupt the backup.

  * `pre` and `post`, called by the systemd-sleep hook
    /usr/lib/systemd/system-sleep/50-mbp-sleep.  These do the device work
    around a sleep: detach the Thunderbolt Ethernet endpoint and the Wi-Fi,
    unmount the CIFS shares, and put all three back afterwards.

Anything that can fail is logged and swallowed.  Nothing here is allowed to
abort a sleep transaction, because a machine that refuses to sleep is worse than
one that sleeps imperfectly.

Design notes that are easy to get wrong again:

  * The Wi-Fi must be disconnected before the driver is unloaded.  Unloading it
    while wpa_supplicant still holds the interface leaves the process in state D
    and the suspend never happens ("The brcmfmac trap").
  * `post` must not wait for NetworkManager.  logind only tells NetworkManager
    to come back after systemd-sleep returns, i.e. after this hook.  The
    verification therefore runs detached, in `wifi-verify`.
  * /proc/acpi/wakeup is a toggle, not a setter.  Read first, write only on a
    real change, or a second write silently disables the source again.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

TAG = "mbp-sleep"
DEFAULT_CONF = "/etc/mbp-sleep.conf"
RUN_DIR = Path("/run/mbp-sleep")
WAKEUP = "/proc/acpi/wakeup"
INSTALLED_VERSION = Path("/usr/local/share/mbp-sleep/VERSION")


def version() -> str:
    """The single version source is the VERSION file, next to this script.

    In the repository that is `./VERSION`; `install.sh` copies it to
    `/usr/local/share/mbp-sleep/VERSION` for the installed program.
    """
    for candidate in (Path(__file__).resolve().with_name("VERSION"),
                      INSTALLED_VERSION):
        try:
            text = candidate.read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if text:
            return text
    return "unknown"

